{
  "config": {
    "default": true,
    // Prose is written one paragraph per line.
    "MD013": false,
    // Contact addresses are written as plain text.
    "MD034": false,
    // The README opens with the banner image, centered with HTML.
    "MD033": false,
    "MD041": false
  },
  "globs": ["**/*.md"],
  // The pull request template starts at a second level heading by design.
  // AGENTS.md is a local, gitignored file. .work/ holds local, gitignored briefs and reports.
  "ignores": ["**/node_modules/**", ".github/pull_request_template.md", "AGENTS.md", ".work/**"]
}
