# Copy to .env for local overrides. Leave a value empty to use the default.
UPMO_LISTEN_ADDR=
UPMO_SHUTDOWN_TIMEOUT=
UPMO_LOG_LEVEL=
# sandboxd driver: auto (Docker when the engine answers, else the stub), docker or stub.
UPMO_SANDBOX_DRIVER=
# openssl rand -base64 32, then prefix upmo_svc_
UPMO_SERVICE_KEY=
UPMO_SERVICE_KEY_PREVIOUS=
# Email invite and recover links. Leave UPMO_SMTP_HOST empty to only copy links.
# Port defaults to 587 (STARTTLS when offered). User and password go together.
UPMO_SMTP_HOST=
UPMO_SMTP_PORT=
UPMO_SMTP_USER=
UPMO_SMTP_PASSWORD=
UPMO_SMTP_FROM=
