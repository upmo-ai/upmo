# Copy to .env for local overrides. Leave a value empty to use the default.
UPMO_LISTEN_ADDR=
UPMO_SHUTDOWN_TIMEOUT=
UPMO_LOG_LEVEL=
# sandboxd driver: auto (Docker when the engine answers, else the stub), docker or stub.
# The stub runs no commands, so a task that needs a sandbox fails provisioning.
UPMO_SANDBOX_DRIVER=
# Docker sandboxes join an internal network (default upmo-sandbox-egress) and
# reach the egress proxy at this URL (default http://host.docker.internal:3128).
# Compose sets both: the project's sandbox-egress network and http://sandboxd:3128.
UPMO_SANDBOX_NETWORK=
UPMO_EGRESS_PROXY_URL=
# Image each task sandbox starts from. Empty is debian:bookworm-slim, which has
# no git. For a task with a repository: docker compose build sandbox-image,
# then upmo/sandbox:base.
UPMO_SANDBOX_IMAGE=
# compose.yml sets development service keys. See docs/configuration.md to
# generate real ones. UPMO_SERVICE_KEY is refused, even when empty.
# Email invite and recover links. Leave UPMO_SMTP_HOST empty to only copy links.
# Port defaults to 587 (STARTTLS when offered). User and password go together.
UPMO_SMTP_HOST=
UPMO_SMTP_PORT=
UPMO_SMTP_USER=
UPMO_SMTP_PASSWORD=
UPMO_SMTP_FROM=
